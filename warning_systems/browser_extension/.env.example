# QuakeShield Browser Extension configuration
# Copy these values into the extension Settings page after loading unpacked.

# Full URL for QuakeShield backend event endpoint (no default endpoint is assumed)
QUAKESHIELD_BACKEND_EVENTS_URL=

# Optional dashboard URL opened by popup quick action
QUAKESHIELD_DASHBOARD_URL=

# Official feed URL (defaults to USGS all_hour if not set)
OFFICIAL_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_hour.geojson
